# Kopiera till .env.oidc.local och starta med `yarn dev:oidc`.
# Värdena här går före .env.development.local, så filen behöver bara innehålla det som skiljer.

# WSO2-labbet
API_BASE_URL={{INSERT WSO2 LAB GATEWAY URL}}
CLIENT_KEY={{INSERT WSO2 LAB CLIENT KEY}}
CLIENT_SECRET={{INSERT WSO2 LAB CLIENT SECRET}}

# OneGate test
OIDC_ENABLED=true
OIDC_ISSUER_URL={{INSERT ISSUER URL FROM IAM}}
OIDC_CLIENT_ID={{INSERT CLIENT ID FROM IAM}}
OIDC_CLIENT_SECRET={{INSERT CLIENT SECRET FROM IAM}}
OIDC_CALLBACK_URL=http://localhost:3001/api/oidc/login/callback
OIDC_SCOPES=openid profile email

# Användarbunden WSO2-token (RFC 7523)
WSO2_USER_TOKEN_EXCHANGE_ENABLED=true
WSO2_TOKEN_EXCHANGE_ASSERTION=access_token

APP_ENV=test
