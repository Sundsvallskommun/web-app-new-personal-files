{
  "name": "web-app-new-personal-files",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "yarn generate:middleware-envs",
    "dev": "cross-env TEST=true next dev",
    "prebuild": "yarn generate:middleware-envs",
    "build": "yarn lint && yarn type-check && next build",
    "prebuild:test": "yarn generate:middleware-envs",
    "build:test": "cross-env TEST=true next build",
    "start": "next start",
    "generate:middleware-envs": "node middleware-envs-generator.mjs",
    "generate:contracts": "cross-env NODE_ENV=development npx tsx ./src/swagger-typescript-api.ts",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint . --fix",
    "analyze": "cross-env ANALYZE=true next build",
    "analyze:server": "cross-env BUNDLE_ANALYZE=server next build",
    "analyze:browser": "cross-env BUNDLE_ANALYZE=browser next build",
    "cypress": "cypress open",
    "cypress:headless": "cross-env TEST=true npx cypress run --component && npx cypress run --e2e",
    "jest": "jest --watch",
    "jest:coverage": "jest --coverage",
    "test": "concurrently \"yarn jest\" \"yarn cypress\"",
    "coverage": "yarn nyc report --reporter=text-summary",
    "coverage:merge": "istanbul-merge --out coverage/summary/coverage-final.json coverage/cypress/coverage-final.json coverage/jest/coverage-final.json && nyc report --reporter=lcov -t coverage/summary --report-dir coverage/summary --check-coverage false",
    "test:coverage": "yarn cypress:headless && yarn jest:coverage && yarn coverage:merge",
    "type-check": "tsc --pretty --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@sk-web-gui/core": "4.6.2",
    "@sk-web-gui/react": "3.0.14",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "i18next": "^24.2.3",
    "i18next-resources-to-backend": "^1.2.3",
    "lodash": "^4.18.1",
    "lucide-react": "0.576.0",
    "next": "16.2.12",
    "next-i18n-router": "^5.5.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^15.7.4",
    "sass": "^1.106.1",
    "sharp": "^0.35.5",
    "yup": "^1.7.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@cypress/code-coverage": "^3.14.7",
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@simonsmith/cypress-image-snapshot": "^10.1.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.10.0",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.27",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.6.1",
    "babel-jest": "^29.7.0",
    "babel-plugin-istanbul": "^6.1.1",
    "cross-env": "^7.0.3",
    "cypress": "^14.5.4",
    "dotenv": "^16.6.1",
    "envalid": "^8.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "identity-obj-proxy": "^3.0.0",
    "istanbul-merge": "^2.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "nyc": "^15.1.0",
    "postcss": "^8.5.31",
    "postcss-import": "^16.2.0",
    "prettier": "^3.9.10",
    "swagger-typescript-api": "^13.13.0",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "resolutions": {
    "@sk-web-gui/theme": "2.7.2",
    "**/@sk-web-gui/forms/uuid": "^11.1.1",
    "js-yaml": "^4.3.2",
    "postcss": "^8.5.31",
    "qs": "^6.16.1",
    "sharp": "^0.35.5"
  },
  "browserslist": [
    "defaults and fully supports es6-module"
  ]
}
